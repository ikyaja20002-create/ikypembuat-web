      --bg-elevated: #121726;
      --bg-card: rgba(21, 27, 44, 0.74);
      --bg-card-hover: rgba(29, 38, 62, 0.9);
      --text-primary: #f6f3ec;
      --text-secondary: #b9b4a8;
      --text-muted: #7c7a74;
      --gold-primary: #e5c173;
      --gold-bright: #f7df9c;
      --gold-dim: rgba(229, 193, 115, 0.18);
      --accent-rose: #d98a7e;
      --accent-sage: #7fa99b;
      --border-subtle: rgba(229, 193, 115, 0.16);
      --border-strong: rgba(229, 193, 115, 0.42);
      --shadow-gold: 0 12px 40px rgba(229, 193, 115, 0.14);
      --shadow-deep: 0 24px 60px rgba(0, 0, 0, 0.55);
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --radius-sm: 12px;
      --radius-md: 20px;
      --radius-lg: 28px;
      --radius-pill: 999px;
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      background-color: var(--bg-deep);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    body {
      font-family: var(--font-sans);
      background:
        radial-gradient(circle at 15% 10%, rgba(229, 193, 115, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 85% 25%, rgba(127, 169, 155, 0.07) 0%, transparent 45%),
        radial-gradient(circle at 50% 85%, rgba(217, 138, 126, 0.06) 0%, transparent 50%),
        var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
      user-select: none;
    }
        body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 1;
    }

    #particle-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
    }

    #touch-layer {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 999;
      overflow: hidden;
    }

    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 0%;
      height: 3px;
      background: linear-gradient(90deg, var(--gold-primary), var(--gold-bright), var(--accent-rose));
      box-shadow: 0 0 12px rgba(229, 193, 115, 0.7);
      z-index: 1001;
      transition: width 0.1s linear;
    }

    .sound-toggle {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 1002;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: var(--radius-pill);
      background: rgba(18, 23, 38, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border-strong);
      color: var(--gold-bright);
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: var(--shadow-deep);
      transition: transform 0.25s var(--ease-spring), background 0.25s ease, border-color 0.25s ease;
    }
        .sound-toggle:active {
      transform: scale(0.93);
    }

    .sound-toggle .eq-bars {
      display: inline-flex;
      align-items: flex-end;
      gap: 2px;
      height: 12px;
      width: 14px;
    }

    .sound-toggle .eq-bars span {
      display: block;
      width: 3px;
      height: 4px;
      border-radius: 2px;
      background: var(--gold-bright);
      transition: height 0.2s ease, opacity 0.2s ease;
    }

    .sound-toggle.is-playing .eq-bars span:nth-child(1) {
      animation: eqBounce 0.9s infinite ease-in-out;
    }
    .sound-toggle.is-playing .eq-bars span:nth-child(2) {
      animation: eqBounce 0.7s 0.15s infinite ease-in-out;
    }
    .sound-toggle.is-playing .eq-bars span:nth-child(3) {
      animation: eqBounce 1.05s 0.3s infinite ease-in-out;
    }

    .sound-toggle:not(.is-playing) .eq-bars span {
      height: 3px;
      opacity: 0.45;
    }

    @keyframes eqBounce {
      0%, 100% { height: 3px; }
      50% { height: 12px; }
    }

    .app-wrapper {
      position: relative;
      z-index: 10;
      max-width: 540px;
      margin: 0 auto;
      padding: 0 20px 115px;
    }

    .hero {
      min-height: 94vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding-top: 64px;
      padding-bottom: 36px;
      position: relative;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      border-radius: var(--radius-pill);
      background: var(--gold-dim);
      border: 1px solid var(--border-strong);
      color: var(--gold-bright);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 22px;
      opacity: 0;
      transform: translateY(18px);
      animation: heroReveal 0.9s var(--ease-out) 0.15s forwards;
    }
        .hero-emblem {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      background: linear-gradient(145deg, rgba(229, 193, 115, 0.22), rgba(21, 27, 44, 0.9));
      border: 1px solid var(--border-strong);
      display: grid;
      place-items: center;
      margin-bottom: 24px;
      box-shadow: 0 0 40px rgba(229, 193, 115, 0.22);
      position: relative;
      opacity: 0;
      transform: scale(0.85);
      animation: emblemReveal 1s var(--ease-spring) 0.3s forwards;
    }

    .hero-emblem::after {
      content: "";
      position: absolute;
      inset: -7px;
      border-radius: 50%;
      border: 1px dashed rgba(229, 193, 115, 0.35);
      animation: slowSpin 24s linear infinite;
    }

    @keyframes slowSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .hero-emblem svg {
      width: 36px;
      height: 36px;
      fill: var(--gold-bright);
    }

    .hero-title {
      font-family: var(--font-serif);
      font-size: clamp(2.35rem, 8.5vw, 3.35rem);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.01em;
      color: var(--text-primary);
      margin-bottom: 14px;
      opacity: 0;
      transform: translateY(22px);
      animation: heroReveal 0.95s var(--ease-out) 0.45s forwards;
    }

    .hero-title span {
      display: block;
      font-style: italic;
      background: linear-gradient(135deg, var(--gold-bright), var(--gold-primary), #e9a699);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: 0.98rem;
      color: var(--text-secondary);
      max-width: 400px;
      margin: 0 auto 30px;
      font-weight: 400;
      opacity: 0;
      transform: translateY(20px);
      animation: heroReveal 0.95s var(--ease-out) 0.6s forwards;
    }

    .hero-cta-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      width: 100%;
      max-width: 310px;
      opacity: 0;
      transform: translateY(20px);
      animation: heroReveal 0.95s var(--ease-out) 0.75s forwards;
    }
        .btn-gold {
      width: 100%;
      padding: 15px 24px;
      border-radius: var(--radius-pill);
      border: none;
      background: linear-gradient(135deg, var(--gold-bright), var(--gold-primary));
      color: #12151f;
      font-family: var(--font-sans);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      display: inline-flex;
      align-items: center;
      justify-content: center;
